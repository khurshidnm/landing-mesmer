# ===================================================
# MESMER Website & Admin CMS Environment Configuration
# ===================================================

# MongoDB Connection String
# e.g., mongodb://localhost:27017/mesmer or mongodb+srv://<user>:<password>@cluster.mongodb.net/mesmer
MONGODB_URI=mongodb://localhost:27017/mesmer

# NextAuth Configuration
# Run `openssl rand -base64 32` to generate secure secrets
NEXTAUTH_SECRET=your-nextauth-secret-here
NEXTAUTH_JWT_SECRET=your-nextauth-jwt-secret-here
NEXTAUTH_URL=http://localhost:3000

# Telegram Bot Integration for Contact Form and Career Submissions
# Create a bot via @BotFather and get chat ID via @userinfobot or channel ID
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=-1002471201680

# Initial Admin Credentials (auto-seeded if no admins exist)
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=your-secure-admin-password

# Optional root path for file uploads (defaults to process.cwd())
ROOT_PATH=

# Cloudflare Turnstile (spam protection on public forms)
# Create a free widget at https://dash.cloudflare.com/?to=/:account/turnstile
# Add your domains (mesmer.uz, www.mesmer.uz, localhost). Leave both empty to disable.
# (NEXT_PUBLIC_TURNSTILE_SITE_KEY also works for the site key.)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
